# ============================================================
# StressIntel PRO — Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Flask
# ------------------------------------------------------------

SECRET_KEY=replace-with-a-long-random-secret-key

FLASK_DEBUG=false
FLASK_ENV=development


# ------------------------------------------------------------
# GROQ
# ------------------------------------------------------------

# Never commit the real API key.
GROQ_API_KEY=your-groq-api-key-here

# Keep the model configurable so the research configuration
# can be changed without modifying application code.
GROQ_MODEL=llama-3.3-70b-versatile


# ------------------------------------------------------------
# Machine Learning Artifacts
# ------------------------------------------------------------

MODEL_PATH=models/stressintel_xgboost.json

PREPROCESSOR_PATH=models/stressintel_preprocessor.joblib

CALIBRATOR_PATH=models/stressintel_calibrator.joblib

MODEL_VERSION=stressintel-xgb-v1.0.0


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

# Development:
CORS_ORIGINS=*

# Production example:
# CORS_ORIGINS=https://your-domain.vercel.app


# ------------------------------------------------------------
# Session Security
# ------------------------------------------------------------

# Set to true when the application is served exclusively
# through HTTPS.
SESSION_COOKIE_SECURE=false


# ------------------------------------------------------------
# Optional Research Capabilities
# ------------------------------------------------------------

# Webcam analysis is disabled by default.
ENABLE_WEBCAM=false

# Research analytics are enabled by default.
ENABLE_RESEARCH_ANALYTICS=true

# GROQ qualitative journal analysis.
ENABLE_GROQ_ANALYSIS=true


# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

LOG_LEVEL=INFO

# Local development only.
# Production deployments should prefer platform-managed logs.
LOG_DIRECTORY=logs